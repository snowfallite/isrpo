@model DrinksApp.Models.Drink
@{
    ViewBag.Title = "Выбор напитка";
}

<h2>Выбор напитка</h2>

@using (Html.BeginForm("DrinkForm", "Home", FormMethod.Post))
{
    <div>
        @Html.LabelFor(m => m.DrinkType)
        @Html.DropDownListFor(m => m.DrinkType, (SelectList)ViewBag.Drinks, "-- Выберите напиток --")
        @Html.ValidationMessageFor(m => m.DrinkType)
    </div>

    <div>
        @Html.LabelFor(m => m.Milk)
        @Html.TextBoxFor(m => m.Milk)
        @Html.ValidationMessageFor(m => m.Milk)
    </div>

    <div>
        @Html.LabelFor(m => m.Sugar)
        @Html.TextBoxFor(m => m.Sugar)
        @Html.ValidationMessageFor(m => m.Sugar)
    </div>

    <button type="submit">Ok</button>
}
